VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_TUS_UPLOAD_CHUNK_SIZE=10485760
# Comma-separated retry delays in seconds.
VITE_TUS_UPLOAD_RETRY_INTERVAL=1,3,5,10,30,60
# Optional override, useful when the WebSocket service uses a different origin or path.
# Defaults to /ws at the REST API origin (not /api/v1/ws).
VITE_WS_URL=http://localhost:8080/ws
